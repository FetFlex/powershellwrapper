# ============================================================
# DATABASE
# ============================================================

# SQLite (lokal udvikling - nul opsætning):
DATABASE_URL="file:./dev.db"

# PostgreSQL (Neon - cloud deploy):
# 1. Opret gratis konto på neon.tech
# 2. Lav nyt projekt → kopiér "Connection string"
# 3. Skift "sqlite" til "postgresql" i prisma/schema.prisma
# DATABASE_URL="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ============================================================
# NEXTAUTH
# ============================================================
NEXTAUTH_URL="http://localhost:3000"
# Generer med: openssl rand -base64 32
NEXTAUTH_SECRET="skift-denne-til-noget-tilfaeldigt"

# ============================================================
# AI PROVIDER (valgfri - appen virker uden)
# ============================================================

# Claude (Anthropic) → console.anthropic.com
# ANTHROPIC_API_KEY="sk-ant-..."

# Google Gemini (gratis tier: 1M tokens/dag) → aistudio.google.com/apikey
# GOOGLE_AI_KEY="AIza..."

# Automatisk: bruger Claude hvis tilgængelig, ellers Gemini
# AI_PROVIDER=auto
