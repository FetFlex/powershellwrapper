# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/running_coach"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# AI Provider - vælg én (eller ingen for at deaktivere AI-funktioner)
# AI_PROVIDER=auto   <- vælger automatisk baseret på hvilken nøgle der er sat (standard)
# AI_PROVIDER=claude <- tving Claude
# AI_PROVIDER=gemini <- tving Gemini

# Claude (Anthropic) - https://console.anthropic.com
# ANTHROPIC_API_KEY="sk-ant-..."

# Google Gemini (gratis tier tilgængeligt) - https://aistudio.google.com/apikey
# GOOGLE_AI_KEY="AIza..."
